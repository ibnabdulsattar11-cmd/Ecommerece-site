# Backend API base URL (must include /api)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Public site URL — used for canonical URLs, sitemap.xml, Open Graph tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Currency shown across the storefront (ISO 4217 code)
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_CURRENCY_LOCALE=en-US

# Stripe publishable key (safe to expose client-side) — leave unset to
# disable card payments; Cash on Delivery still works without it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
